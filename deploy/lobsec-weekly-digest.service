[Unit]
Description=UAE RE Weekly Intelligence Digest
After=lobsec.service

[Service]
Type=oneshot
User=lobsec
EnvironmentFile=/opt/lobsec/boot/pin.env
EnvironmentFile=/opt/lobsec/.openclaw/.env
ExecStart=/opt/lobsec/bin/weekly-digest.sh
TimeoutStartSec=120
StandardOutput=append:/opt/lobsec/logs/digest.log
StandardError=append:/opt/lobsec/logs/digest.log

# Security hardening (match existing services)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lobsec
